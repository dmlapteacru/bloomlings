{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloomlings.game/schemas/round-picture.v1.json",
  "title": "round-picture.v1",
  "description": "An approved round picture (spec 006 FR-021). Rows top first: material codes, '.' empty, '#' stream, 'b' bridge site.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "version", "title", "w", "h", "rows", "approval", "rights"],
  "properties": {
    "format": {"const": "round-picture.v1"},
    "id": {"type": "string", "pattern": "^P[0-9]{4}$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "family": {"type": "string"},
    "direction": {"type": "string"},
    "subject": {"type": "string"},
    "source": {"type": "string"},
    "w": {"type": "integer", "minimum": 1, "maximum": 44},
    "h": {"type": "integer", "minimum": 1, "maximum": 44},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[GPBACDVYOLMRKNSE.#b]+$"}},
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["status", "by", "decidedAt"],
      "properties": {"status": {"const": "approved"}, "by": {"const": "owner"}, "decidedAt": {"type": "string"}}
    },
    "rights": {"const": "own"}
  }
}
