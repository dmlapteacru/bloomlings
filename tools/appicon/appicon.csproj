<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The launcher icon maker (spec 005 pictures.md C3): cuts the owner's app icon picture (source/app-icon.png) into the
    Android launcher icons of both builds. Dev-only: it never ships. Run: dotnet run, project tools/appicon (README.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bloomlings.AppIcon</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
  </ItemGroup>
</Project>
