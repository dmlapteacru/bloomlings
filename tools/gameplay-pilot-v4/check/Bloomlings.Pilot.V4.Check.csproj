<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile actual rules into a test-only assembly. Explicit adapters add
         pair reservations, capacity, top reveal and a bridge; the shipping Core remains unchanged. -->
    <Compile Include="../../../core/src/Bloomlings.Core/**/*.cs"
             Exclude="../../../core/src/Bloomlings.Core/obj/**;../../../core/src/Bloomlings.Core/bin/**;../../../core/src/Bloomlings.Core/Polyfills/**;../../../core/src/Bloomlings.Core/Progression/**" />
  </ItemGroup>
</Project>
