<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the actual rules sources into this test-only assembly. This lets
         the bridge adapter open a non-target cell without changing the product
         API or adding a new command to the shipping core before playtesting. -->
    <Compile Include="../../../core/src/Bloomlings.Core/**/*.cs"
             Exclude="../../../core/src/Bloomlings.Core/obj/**;../../../core/src/Bloomlings.Core/bin/**;../../../core/src/Bloomlings.Core/Polyfills/**;../../../core/src/Bloomlings.Core/Progression/**" />
  </ItemGroup>
</Project>
