<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Checks the playtest client's engine-free parts without Android: LevelAnimator replays every golden case and every
    showcase solution (with pauses and with rapid taps) and the settled screen must equal the rules state; PlaytestMeta
    runs progression, unlocks, Petals and milestones on the linked client services.
    Run: dotnet run, project playtest/check (exit code 1 on a failure).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bloomlings.Playtest.Check</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../playtest/android/LevelAnimator.cs" />
    <Compile Include="../../playtest/design/PlaytestMeta.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Config/BundledRemoteConfigService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Meta/Wardrobe/WardrobeService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Meta/DailyReward/DailyRewardService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Meta/Collection/CollectionService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Meta/Profile/*.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Save/PlayerSave.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Save/SaveSerializer.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Save/SaveService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Clock/IClock.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Clock/SystemClock.cs" />
    <Compile Include="../../client/Assets/Bloomlings/App/Progression/ProgressionService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/App/Progression/MilestoneService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/App/Progression/MilestoneTable.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Economy/EconomyService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Economy/EconomyConfig.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Config/IRemoteConfigService.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Services/Config/RemoteConfigKeys.cs" />
    <Compile Include="../../client/Assets/Bloomlings/Meta/Wardrobe/CosmeticCatalog.cs" />
    <EmbeddedResource Include="../../client/Assets/Bloomlings/Meta/Wardrobe/Resources/CosmeticCatalog.json" LogicalName="cosmetics/CosmeticCatalog.json" />
    <ProjectReference Include="../../core/src/Bloomlings.Core/Bloomlings.Core.csproj" />
    <ProjectReference Include="../../core/src/Bloomlings.Content/Bloomlings.Content.csproj" />
  </ItemGroup>
</Project>
