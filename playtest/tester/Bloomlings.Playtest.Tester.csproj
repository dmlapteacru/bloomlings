<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The level tester APK: the playtest sources (playtest/android) built with PLAYTEST_TESTER. Levels open straight
    away with ◀ ▶ to move between them, every booster is free, and a tap shows its result at once; there is no Home,
    progression or economy. Its own application id, so it installs next to the full playtest. See playtest/README.md.
    It carries the round levels only (spec 006 FR-060, Catalog.props), as the full playtest: the legacy oversized board
    prototypes (content/curated/dev, content/pictures/dev) are no longer packed.
  -->
  <Import Project="../Playtest.Shared.props" />

  <PropertyGroup>
    <ApplicationId>com.bloomlings.playtest.tester</ApplicationId>
    <ApplicationTitle>Bloomlings Tester</ApplicationTitle>
    <DefineConstants>$(DefineConstants);PLAYTEST_TESTER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../android/*.cs" />
    <!-- The clearing styles' timing, which the animator schedules by (the tester keeps its own minimal look). -->
    <Compile Include="../../client/Assets/Bloomlings/UI/Design/ClearStyles.cs" Link="Shared/Design/ClearStyles.cs" />
    <!-- Which tap waits for a connected partner, for the refusal's message (spec 005 FR-043; the rules only, no pictures). -->
    <Compile Include="../../client/Assets/Bloomlings/UI/Design/PodLinkRules.cs" Link="Shared/Design/PodLinkRules.cs" />
    <!-- CosmeticCatalog resolves achievement badge names; the tester shares that catalog, without profile UI. -->
    <Compile Include="../../client/Assets/Bloomlings/Meta/Profile/Achievements.cs" Link="Shared/Achievements.cs" />
  </ItemGroup>

</Project>
