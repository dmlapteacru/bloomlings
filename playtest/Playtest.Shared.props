<Project>
  <!--
    Shared by the two playtest APKs (playtest/android, the full playtest, and playtest/tester, the level tester): the
    Android settings, the shared core, the Unity client's engine-free logic (linked, never copied), the playtest levels
    and the picture library. See playtest/README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bloomlings.Playtest</RootNamespace>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::ValueOrDefault('$(GITHUB_RUN_NUMBER)', '1'))</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../core/src/Bloomlings.Core/Bloomlings.Core.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../core/src/Bloomlings.Content/Bloomlings.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Unity client's engine-free logic, linked (never copied): sound synthesis and its policy, the save file, progression and
      unlocks, Petals and booster charges, milestones, and the ink contrast rule. The playtest only draws and calls it.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Feedback/ToneSynth.cs" Link="Shared/ToneSynth.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Feedback/ClearSounds.cs" Link="Shared/ClearSounds.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Feedback/HapticPattern.cs" Link="Shared/HapticPattern.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Feedback/FeedbackPolicy.cs" Link="Shared/FeedbackPolicy.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Save/PlayerSave.cs" Link="Shared/PlayerSave.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Save/SaveSerializer.cs" Link="Shared/SaveSerializer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Save/SaveService.cs" Link="Shared/SaveService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Clock/IClock.cs" Link="Shared/IClock.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Clock/SystemClock.cs" Link="Shared/SystemClock.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/App/Progression/ProgressionService.cs" Link="Shared/ProgressionService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/App/Progression/MilestoneService.cs" Link="Shared/MilestoneService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/App/Progression/MilestoneTable.cs" Link="Shared/MilestoneTable.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Economy/EconomyService.cs" Link="Shared/EconomyService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Economy/EconomyConfig.cs" Link="Shared/EconomyConfig.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Config/IRemoteConfigService.cs" Link="Shared/IRemoteConfigService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Services/Config/RemoteConfigKeys.cs" Link="Shared/RemoteConfigKeys.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Meta/Wardrobe/CosmeticCatalog.cs" Link="Shared/CosmeticCatalog.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/Art/Variants/InkContrast.cs" Link="Shared/InkContrast.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../client/Assets/Bloomlings/UI/Localization/Resources/Strings_en.csv" LogicalName="strings/Strings_en.csv" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The whole level catalog, L1–5000 (content/catalog/levels), and the picture library, each file read on first use
      (PlaytestContent): the APK's assets, kept once and compressed, not embedded resources (PlaytestFiles).
    -->
    <AndroidAsset Include="$(MSBuildThisFileDirectory)../content/catalog/levels/*.json" Link="Assets/levels/%(Filename)%(Extension)" />
    <AndroidAsset Include="$(MSBuildThisFileDirectory)../content/pictures/lib/*.json" Link="Assets/pictures/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The owner's app icon (spec 005 pictures.md C3), written by tools/appicon: the adaptive icon (a picture background, a
      transparent foreground) and the round and legacy icons, for both APKs.
    -->
    <AndroidResource Include="$(MSBuildThisFileDirectory)icon/**/*" Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
