{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bloomlings.game/schemas/round-level.v1.json",
  "title": "round-level.v1",
  "description": "A round level in the game (spec 006 FR-020). Rows are the reference engine's input: bottom first, '.' open, '#' wall, a material code otherwise; the frame ring and wall are part of the rows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "number", "definitionVersion", "class", "picture", "board", "capacity", "pods", "tray", "mechanics", "engine"],
  "properties": {
    "format": {"const": "round-level.v1"},
    "number": {"type": "integer", "minimum": 1},
    "definitionVersion": {"type": "integer", "minimum": 1},
    "class": {"enum": ["Normal", "Hard", "Super Hard"]},
    "introduction": {
      "type": "object", "additionalProperties": false, "required": ["mechanic", "second"],
      "properties": {"mechanic": {"enum": ["hidden", "links", "bridge"]}, "second": {"type": "boolean"}}
    },
    "picture": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"type": "string", "pattern": "^P[0-9]{4}$"}, "version": {"type": "integer", "minimum": 1}}
    },
    "board": {
      "type": "object", "additionalProperties": false, "required": ["w", "h", "rowsBottomFirst", "entries"],
      "properties": {
        "w": {"type": "integer", "minimum": 7, "maximum": 48},
        "h": {"type": "integer", "minimum": 8, "maximum": 48},
        "rowsBottomFirst": {"type": "array", "items": {"type": "string", "pattern": "^[GPBACDVYOLMRKNSE.#]+$"}},
        "entries": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "hero": {
          "type": "object", "additionalProperties": false, "required": ["id", "choices"],
          "properties": {
            "id": {"const": "sprig-bridge"},
            "choices": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
              "type": "object", "additionalProperties": false, "required": ["cell", "anchor", "label"],
              "properties": {"cell": {"type": "integer", "minimum": 0}, "anchor": {"type": "integer", "minimum": 0}, "label": {"type": "string"}}
            }}
          }
        }
      }
    },
    "capacity": {"const": 5},
    "pods": {"type": "array", "minItems": 2, "items": {
      "type": "object", "additionalProperties": false, "required": ["code", "count"],
      "properties": {
        "code": {"type": "string", "pattern": "^[GPBACDVYOLMRKNSE]$"},
        "count": {"type": "integer", "minimum": 1, "maximum": 60},
        "mystery": {"const": "depth"},
        "group": {"type": "string", "pattern": "^[A-Z][0-9]*$"}
      }
    }},
    "tray": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}},
    "mechanics": {"type": "array", "uniqueItems": true, "items": {"enum": ["hidden", "links", "bridge"]}},
    "exception": {
      "type": "object", "additionalProperties": false, "required": ["rule", "reason", "decidedBy", "decidedAt"],
      "properties": {"rule": {"type": "string"}, "reason": {"type": "string"}, "decidedBy": {"const": "owner"}, "decidedAt": {"type": "string", "format": "date"}}
    },
    "engine": {"$ref": "#/$defs/engine"}
  },
  "$defs": {
    "engine": {
      "type": "object", "additionalProperties": false, "required": ["rules", "timeline", "palette", "clock"],
      "properties": {
        "rules": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "timeline": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "palette": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clock": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
