<Project Sdk="Microsoft.NET.Sdk">
  <!-- Level/picture/manifest serialization and packs. Shared with Unity (com.bloomlings.content). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bloomlings.Core/Bloomlings.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The contract schemas, unchanged, for tools that validate against them (pipeline `validate`). -->
    <EmbeddedResource Include="Schemas/*.schema.json" LogicalName="Bloomlings.Content.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
